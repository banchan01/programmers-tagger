{
  "manifest_version": 3,
  "name": "Programmers Tagger - 프로그래머스 문제 유형 태그",
  "version": "1.0.0",
  "description": "프로그래머스 문제 목록과 문제 화면에 미리 분류해 둔 알고리즘 유형을 표시합니다.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "문제 유형 표시 설정" },
  "content_scripts": [{
    "matches": ["https://school.programmers.co.kr/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["labels.json"],
    "matches": ["https://school.programmers.co.kr/*"]
  }]
}
